    <worksheet name='Revenue Change %'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Revenue Change %  &#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_dataset' name='federated.0pouyir1kgd3621b61vkp1pdmtu6' />
          </datasources>
          <datasource-dependencies datasource='federated.0pouyir1kgd3621b61vkp1pdmtu6'>
            <column caption='Revenue Change % ' datatype='real' default-format='p0.0%' name='[Calculation_0233706494353408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Simulated_Revenue]) - SUM([Revenue])) / SUM([Revenue])' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Customer Segment' datatype='string' name='[Customer_Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Revenue]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Simulated_Revenue]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer_Segment]' derivation='None' name='[none:Customer_Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0233706494353408]' derivation='User' name='[usr:Calculation_0233706494353408:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0pouyir1kgd3621b61vkp1pdmtu6].[none:Category:nk]</column>
            <column>[federated.0pouyir1kgd3621b61vkp1pdmtu6].[none:Customer_Segment:nk]</column>
            <column>[federated.0pouyir1kgd3621b61vkp1pdmtu6].[none:Region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-weight' value='normal' />
            <format attr='font-family' data-class='subtotal' value='Tableau Light' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-weight' data-class='total' scope='rows' value='normal' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#2cd420' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-weight' value='bold' />
            <format attr='font-family' value='Times New Roman' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0pouyir1kgd3621b61vkp1pdmtu6].[usr:Calculation_0233706494353408:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run>Æ&#10;</run>
